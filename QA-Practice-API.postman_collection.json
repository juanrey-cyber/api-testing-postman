              }
            }
          ],
          "name": "GET Basic auth without credentials (401)",
          "request": {
            "header": [],
            "method": "GET",
            "url": "{{baseUrlHttpbin}}/basic-auth/user/passwd"
          }
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 without a token', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "GET Bearer without token (401)",
          "request": {
            "header": [],
            "method": "GET",
            "url": "{{baseUrlHttpbin}}/bearer"
          }
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Server echoes the query param back', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.args.test).to.eql('qa');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "GET Echo query params",
          "request": {
            "header": [],
            "method": "GET",
            "url": "{{baseUrlHttpbin}}/get?test=qa"
          }
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Every email matches an email pattern', function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.forEach(function (user) {",
                  "        pm.expect(user.email).to.match(/.+@.+\\..+/);",
                  "    });",
                  "});",
                  "",
                  "pm.test('Every user has geo coordinates as strings', function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.forEach(function (user) {",
                  "        pm.expect(user.address.geo.lat).to.be.a('string');",
                  "        pm.expect(user.address.geo.lng).to.be.a('string');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "GET All users - schema check",
          "request": {
            "header": [],
            "method": "GET",
            "url": "{{baseUrlPlaceholder}}/users"
          }
        }
      ],
      "name": "02 - httpbin (errors and auth)"
    }
  ],
